{
  "name": "shipnow",
  "version": "5.0.0",
  "private": true,
  "description": "ShipNow - Modulo 7: carga de archivos, documentos y comprobantes",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:functional && npm run test:integration",
    "test:unit": "node --import ./tests/support/env.js --test test/*.test.js",
    "test:functional": "mocha --node-option import=./tests/support/env.js",
    "check": "node scripts/check.js",
    "test:integration": "node --import ./tests/support/env.js --test integration/*.integration.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mongoose": "^9.0.0",
    "multer": "^2.5.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "chai": "^6.3.0",
    "mocha": "^11.8.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.0"
  }
}
