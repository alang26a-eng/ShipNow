{
  "name": "shipnow",
  "version": "4.0.0",
  "private": true,
  "description": "API ShipNow — Pre-entrega Módulo 4: logging y monitoreo básico con Winston",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
